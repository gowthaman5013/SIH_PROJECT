@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root {
  /* Warm Linen & Deep Mahogany Design System (High-Trust Institutional / Executive Portal) */
  --bg-main: #FAF7F2;           /* Warm Linen Silk Off-White Canvas */
  --bg-sidebar: #4E3E35;        /* Lighter Warm Chestnut Mahogany Sidebar */
  --bg-card: #FFFFFF;           /* Crisp Pure White Surface Card */
  --bg-header: #3E3029;         /* Warm Chestnut Top Header */
  --border-color: #E6DFD5;      /* Warm Earthy Linen Border */

  --text-primary: #2C221E;        /* Deep Espresso Charcoal Main Text */
  --text-heading: #2C221E;        /* Rich Mahogany Headings */
  --text-secondary: #6E6259;      /* Earthy Muted Slate Secondary Text */
  --text-muted: #8D7B71;          /* Soft Sand Muted Text */
  --text-on-dark: #FAF7F2;

  /* Brand & Action Accents (Terracotta Mahogany & Bronze Sand) */
  --primary-brand: #8B3A2B;      /* Deep Terracotta Mahogany */
  --primary-brand-hover: #6E2D21;/* Dark Velvet Mahogany Hover */
  --dark-primary: #3E3029;       /* Warm Chestnut Mahogany */
  --positive-accent: #7A5230;    /* Warm Bronze Sand Accent */
  --emotional-accent: #F4EFE6;   /* Warm Sand Accent Backdrop */
  --emotional-accent-bg: #FDFBFA;

  /* System Compatibility Variables (Strictly Non-AI, Non-Blue, Non-Green) */
  --primary-navy: #2C221E;
  --deep-navy: #2C221E;
  --primary-blue: #8B3A2B;
  --primary-blue-hover: #6E2D21;
  --soft-blue: #F4EFE6;
  --primary-teal: #8B3A2B;
  --soft-teal: #F3ECE2;
  --primary-teal-border: #E2D4C3;

  --gov-blue: #3E3029;
  --gov-blue-dark: #2A1F1A;

  /* Priority & Risk Status Colors (Earthy Institutional Palette) */
  --risk-low: #7A5230;            /* Warm Sand Bronze */
  --risk-low-bg: #F3ECE2;         /* Soft Linen Tint */
  --risk-moderate: #C47D2B;       /* Warm Amber Ochre */
  --risk-moderate-bg: #FDF3E3;     /* Soft Ochre Tint */
  --risk-high: #9B2C2C;           /* Deep Velvet Crimson */
  --risk-high-bg: #FCEBEB;        /* Soft Crimson Tint */
  --risk-critical: #7B1E1E;       /* Dark Velvet Crimson */
  --risk-critical-bg: #F8DADA;    /* Soft Dark Crimson Tint */

  --shadow-sm: 0 1px 3px 0 rgba(44, 34, 30, 0.04), 0 1px 2px -1px rgba(44, 34, 30, 0.02);
  --shadow-md: 0 4px 6px -1px rgba(44, 34, 30, 0.07), 0 2px 4px -2px rgba(44, 34, 30, 0.04);
  --shadow-lg: 0 10px 15px -3px rgba(44, 34, 30, 0.09), 0 4px 6px -4px rgba(44, 34, 30, 0.04);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  margin: 0;
  padding: 0;
  overflow: hidden;
  font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.app-wrapper {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Official Government Top Header Bar (Warm Chestnut #3E3029) */
.gov-top-header {
  flex-shrink: 0;
  background: #3E3029;
  color: #FAF7F2;
  padding: 0.5rem 1.5rem;
  font-size: 0.82rem;
  font-weight: 600;
  border-bottom: 2px solid #8B3A2B;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  z-index: 1000;
}

.gov-top-header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.gov-top-header-left {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.app-container {
  display: flex;
  flex: 1;
  overflow: hidden;
  height: calc(100vh - 34px);
}

/* Sidebar - Lighter Warm Chestnut Mahogany (#4E3E35) Backdrop with Sand & Terracotta Accents */
.sidebar {
  width: 250px;
  flex-shrink: 0;
  height: 100%;
  overflow-y: auto;
  background-color: #4E3E35;
  color: #FAF7F2;
  display: flex;
  flex-direction: column;
  padding: 1.5rem 1rem;
  border-right: 1px solid #635044;
}

.sidebar-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 1.25rem;
  margin-bottom: 1.25rem;
  border-bottom: 1px solid #635044;
}

.sidebar-logo {
  width: 38px;
  height: 38px;
  background-color: #8B3A2B;
  color: #FFFFFF;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 1.05rem;
  box-shadow: 0 2px 6px rgba(139, 58, 43, 0.4);
}

.sidebar-title {
  font-size: 1.05rem;
  font-weight: 800;
  color: #FAF7F2;
  letter-spacing: -0.02em;
}

.sidebar-subtitle {
  font-size: 0.72rem;
  color: #D6C8BC;
  font-weight: 600;
}

.nav-menu {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  flex: 1;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  color: #D6C8BC;
  text-decoration: none;
  border-radius: 8px;
  font-size: 0.88rem;
  font-weight: 600;
  cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.15s ease;
}

.nav-item:hover {
  background-color: #635044;
  color: #FAF7F2;
}

.nav-item.active {
  background-color: #635044;
  color: #FAF7F2;
  font-weight: 700;
  border-left: 4px solid #E07A5F;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.sidebar-footer {
  padding-top: 1rem;
  border-top: 1px solid #635044;
  font-size: 0.75rem;
  color: #C5B5A7;
}

/* Main Content Area */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-main);
  height: 100%;
  overflow-y: auto;
}

.top-navbar {
  height: 68px;
  background-color: #F4EFE6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2rem;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 1px 2px rgba(44, 34, 30, 0.03);
  flex-shrink: 0;
}

.page-title {
  font-size: 1.4rem;
  font-weight: 800;
  color: #2C221E;
  letter-spacing: -0.02em;
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  background: #FAF7F2;
  padding: 0.4rem 0.85rem 0.4rem 0.5rem;
  border-radius: 30px;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  width: 32px;
  height: 32px;
  background-color: #8B3A2B;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
}

.content-body {
  padding: 1.5rem 2rem 2rem 2rem;
  flex: 1;
}

/* Cards & Layout */
.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.75rem;
  box-shadow: var(--shadow-sm);
  margin-bottom: 1.5rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.25rem;
  margin-bottom: 1.5rem;
}

.stat-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 1.25rem;
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: all 0.2s ease;
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.stat-card.active-filter {
  box-shadow: 0 0 0 2px #8B3A2B, var(--shadow-md);
}

.stat-value {
  font-size: 1.85rem;
  font-weight: 800;
  color: #2C221E;
  margin-top: 0.4rem;
}

/* Badges - Pill Style */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 0.25rem 0.85rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.badge-low { background-color: var(--risk-low-bg); color: var(--risk-low); border: 1px solid #E2D4C3; }
.badge-moderate { background-color: var(--risk-moderate-bg); color: var(--risk-moderate); border: 1px solid #F7DCB4; }
.badge-high { background-color: var(--risk-high-bg); color: var(--risk-high); border: 1px solid #F8C6C6; }
.badge-critical { background-color: var(--risk-critical-bg); color: var(--risk-critical); border: 1px solid #F3AEAE; }

/* Tables */
.table-container {
  overflow-x: auto;
  border-radius: 10px;
  border: 1px solid var(--border-color);
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 0.88rem;
}

th {
  background-color: #F4EFE6;
  color: #2C221E;
  font-weight: 700;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid var(--border-color);
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.03em;
}

td {
  padding: 1rem;
  border-bottom: 1px solid #E6DFD5;
  color: var(--text-primary);
  background-color: #ffffff;
}

tr:hover td {
  background-color: #FAF7F2;
}

/* Buttons - Deep Terracotta Mahogany (#8B3A2B), Sand Bronze (#7A5230), Amber Ochre (#C47D2B), Crimson (#7B1E1E) */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.65rem 1.4rem;
  font-size: 0.88rem;
  font-weight: 700;
  border-radius: 8px;
  border: none;
  cursor: pointer;
  transition: all 0.15s ease;
}

/* Primary Brand Action: Deep Terracotta Mahogany (#8B3A2B) */
.btn-primary {
  background-color: #8B3A2B;
  color: #FFFFFF;
  box-shadow: 0 2px 6px rgba(139, 58, 43, 0.3);
}

.btn-primary:hover {
  background-color: #6E2D21;
}

/* Positive / Sand Bronze: Warm Bronze (#7A5230) */
.btn-success {
  background-color: #7A5230;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(122, 82, 48, 0.25);
}

.btn-success:hover {
  background-color: #5C3D23;
}

/* Warning / Moderate: Warm Amber Ochre (#C47D2B) */
.btn-warning {
  background-color: #C47D2B;
  color: #FFFFFF;
}

.btn-warning:hover {
  background-color: #9E621F;
}

/* Emergency / High-Critical: Crimson Red (#7B1E1E) */
.btn-danger {
  background-color: #7B1E1E;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(123, 30, 30, 0.3);
}

.btn-danger:hover {
  background-color: #5D1515;
}

.btn-outline {
  background-color: #ffffff;
  border: 1px solid #D4C9BC;
  color: #2C221E;
}

.btn-outline:hover {
  background-color: #F4EFE6;
  border-color: #B8AAA1;
  color: #2C221E;
}

/* Filter Pills */
.filter-pill {
  padding: 0.4rem 1.1rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 700;
  border: 1px solid #8B3A2B;
  background-color: #ffffff;
  color: #8B3A2B;
  cursor: pointer;
  transition: all 0.15s ease;
}

.filter-pill.active {
  background-color: #8B3A2B;
  color: #FFFFFF;
  border-color: #8B3A2B;
}

/* Timeline Components */
.timeline {
  position: relative;
  padding-left: 2rem;
  margin-top: 1rem;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 0.65rem;
  top: 0.25rem;
  bottom: 0.25rem;
  width: 2px;
  background-color: var(--border-color);
}

.timeline-item {
  position: relative;
  margin-bottom: 1.5rem;
}

.timeline-marker {
  position: absolute;
  left: -2rem;
  top: 0.15rem;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background-color: #8B3A2B;
  border: 3px solid #ffffff;
  box-shadow: 0 0 0 1px #8B3A2B;
}

.timeline-content {
  background-color: #ffffff;
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 1rem 1.25rem;
}
